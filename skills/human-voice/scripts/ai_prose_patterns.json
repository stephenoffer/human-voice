    "[.?!]\\s+(?:Every\\.\\s+Single\\.\\s+\\w+\\.|Full\\s+stop\\.|Period\\.)",
    "[.?!]\\s+(?:Not|No|Never|Nothing|None)\\.\\s+(?:Not|No|Never|Nothing|None)\\.",
